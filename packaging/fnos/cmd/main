#!/bin/bash
# 飞牛 fnOS 应用主控脚本：由应用中心在启动、停止与状态查询时调用。
#
# 容器本身由应用中心按 app/docker/docker-compose.yaml 拉起，这里只负责状态上报。
FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"

is_docker_running () {
    DOCKER_NAME=""

    if [ -f "$FILE_PATH" ]; then
        DOCKER_NAME=$(cat $FILE_PATH | grep "container_name" | awk -F ':' '{print $2}' | xargs)
        echo "DOCKER_NAME is set to: $DOCKER_NAME"
    fi

    if [ -n "$DOCKER_NAME" ]; then
        docker inspect $DOCKER_NAME | grep -q "\"Status\": \"running\"," || exit 1
        return
    fi
}

case $1 in
start)
    # 容器由应用中心负责启动
    exit 0
    ;;
stop)
    # 容器由应用中心负责停止
    exit 0
    ;;
status)
    # 运行中返回 0，未运行返回 3
    if is_docker_running; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
