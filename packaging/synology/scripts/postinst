#!/bin/sh
# 安装完成后执行。DSM 会紧接着调用 start-stop-status start。
#
# 两个关键点：
# 1. 本脚本由 DSM 以 **root** 执行，而套件固定以 package 用户运行
#    （DSM 7 不给未签名套件 root 权限）。凡是应用要写入的目录都必须把属主
#    交给 package——只 chmod 0755 不够，那对非属主没有写权限，应用会连
#    数据库都建不出来，套件以"无法启动"告终。
# 2. 安装向导（WIZARD_UIFILES/install_uifile）填写的值会以同名环境变量
#    注入本脚本：wizard_server_port、wizard_data_dir。
PKG_NAME="xiaomi-album-syncer"
VAR_DIR="/var/packages/${PKG_NAME}/var"

DATA_DIR="${VAR_DIR}/data"

if [ -d "${VAR_DIR}" ]; then
    chown package "${VAR_DIR}" 2>/dev/null
    chmod 0755 "${VAR_DIR}" 2>/dev/null
fi

# ---- 数据目录 ----
# 默认是 ${VAR_DIR}/data；向导指定了绝对路径时改用该路径，
# 并以软链接挂回 ${VAR_DIR}/data，这样下游脚本无需改动。
if [ -n "${wizard_data_dir:-}" ]; then
    CUSTOM_DIR="${wizard_data_dir%/}"
    case "${CUSTOM_DIR}" in
        /*) ;;
        *)
            echo "[${PKG_NAME}] 忽略非法的数据目录：${wizard_data_dir}" >&2
            CUSTOM_DIR=""
            ;;
    esac

    if [ -n "${CUSTOM_DIR}" ]; then
        if [ -d "${DATA_DIR}" ] && [ ! -L "${DATA_DIR}" ] && [ -n "$(ls -A "${DATA_DIR}" 2>/dev/null)" ]; then
            # 升级场景：已有真实数据目录且非空，保留原位置，避免丢数据
            echo "[${PKG_NAME}] ${DATA_DIR} 已有数据，保留原位置，忽略本次目录设置" >&2
        else
            rm -rf "${DATA_DIR}" 2>/dev/null
            mkdir -p "${CUSTOM_DIR}"
            chown package "${CUSTOM_DIR}" 2>/dev/null
            chmod 0755 "${CUSTOM_DIR}" 2>/dev/null
            ln -s "${CUSTOM_DIR}" "${DATA_DIR}"
            echo "[${PKG_NAME}] 数据目录指向 ${CUSTOM_DIR}" >&2
        fi
    fi
fi

mkdir -p "${DATA_DIR}" 2>/dev/null
chown -R package "${DATA_DIR}" 2>/dev/null

# ---- 端口 ----
# 写入 xas.env，启动脚本会读取它并覆盖默认的 8080。
# 只替换 SERVER_PORT 一行，其余用户自定义配置保持不变。
if [ -n "${wizard_server_port:-}" ]; then
    case "${wizard_server_port}" in
        '' | *[!0-9]*)
            echo "[${PKG_NAME}] 忽略非法的端口：${wizard_server_port}" >&2
            ;;
        *)
            : > "${DATA_DIR}/xas.env.new"
            grep -v '^SERVER_PORT=' "${DATA_DIR}/xas.env" 2>/dev/null >> "${DATA_DIR}/xas.env.new"
            printf 'SERVER_PORT=%s\n' "${wizard_server_port}" >> "${DATA_DIR}/xas.env.new"
            mv "${DATA_DIR}/xas.env.new" "${DATA_DIR}/xas.env"
            chown package "${DATA_DIR}/xas.env" 2>/dev/null
            echo "[${PKG_NAME}] 端口设置为 ${wizard_server_port}" >&2
            ;;
    esac
fi

# 清理旧版本可能遗留的 root 属主目录
for sub in home logs; do
    if [ -d "${DATA_DIR}/${sub}" ]; then
        chown -R package "${DATA_DIR}/${sub}" 2>/dev/null
    fi
done

exit 0
