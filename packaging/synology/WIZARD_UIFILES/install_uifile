[
    {
        "step_title": "Xiaomi Album Syncer Settings",
        "items": [
            {
                "type": "textfield",
                "desc": "Set the port used to access the web interface. Make sure it is not already used by DSM or another package.",
                "subitems": [
                    {
                        "key": "wizard_server_port",
                        "desc": "Web port",
                        "defaultValue": "8080",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^[0-9]{2,5}$/",
                                "errorText": "Please enter a numeric port between 10 and 99999."
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "Optional. Absolute path on the NAS where the database and logs are kept. Leave it blank to use the default location inside the package's var folder. The folder is created automatically if it does not exist.",
                "subitems": [
                    {
                        "key": "wizard_data_dir",
                        "desc": "Data directory",
                        "defaultValue": "",
                        "validator": {
                            "allowBlank": true,
                            "regex": {
                                "expr": "/^\\/[A-Za-z0-9_.-]+(?:\\/[A-Za-z0-9_. -]+)*$/",
                                "errorText": "Please enter an absolute path starting with /."
                            }
                        }
                    }
                ]
            }
        ]
    }
]
