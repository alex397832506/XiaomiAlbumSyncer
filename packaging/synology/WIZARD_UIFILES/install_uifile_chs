[
    {
        "step_title": "小米相册同步 安装设置",
        "items": [
            {
                "type": "textfield",
                "desc": "设置访问 Web 界面使用的端口。请确保该端口没有被 DSM 或其它套件占用。",
                "subitems": [
                    {
                        "key": "wizard_server_port",
                        "desc": "Web 端口",
                        "defaultValue": "8080",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^[0-9]{2,5}$/",
                                "errorText": "请输入 10 到 99999 之间的数字端口。"
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "可选。填写 NAS 上的绝对路径，用于存放数据库与日志。留空则使用套件 var 目录下的默认位置；目录不存在时会自动创建。",
                "subitems": [
                    {
                        "key": "wizard_data_dir",
                        "desc": "数据目录",
                        "defaultValue": "",
                        "validator": {
                            "allowBlank": true,
                            "regex": {
                                "expr": "/^\\/[A-Za-z0-9_.-]+(?:\\/[A-Za-z0-9_. -]+)*$/",
                                "errorText": "请输入以 / 开头的绝对路径。"
                            }
                        }
                    }
                ]
            }
        ]
    }
]
